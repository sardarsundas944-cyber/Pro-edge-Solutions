    },
    {
      "name": "Predict - Valid Input - Success",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sepal_length\": 5.1,\n  \"sepal_width\": 3.5,\n  \"petal_length\": 1.4,\n  \"petal_width\": 0.2\n}"
        },
        "url": {
          "raw": "{{base_url}}/predict",
          "host": ["{{base_url}}"],
          "path": ["predict"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Response has prediction field', function () {",
              "  var body = pm.response.json();",
              "  pm.expect(body).to.have.property('prediction');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Predict - Invalid Input Type - Validation Error",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sepal_length\": \"not-a-number\",\n  \"sepal_width\": 3.5,\n  \"petal_length\": 1.4,\n  \"petal_width\": 0.2\n}"
        },
        "url": {
          "raw": "{{base_url}}/predict",
          "host": ["{{base_url}}"],
          "path": ["predict"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 422', function () {",
              "  pm.response.to.have.status(422);",
              "});",
              "pm.test('Response has detail field', function () {",
              "  var body = pm.response.json();",
              "  pm.expect(body).to.have.property('detail');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Predict - Missing Required Field - Validation Error",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sepal_length\": 5.1,\n  \"sepal_width\": 3.5,\n  \"petal_length\": 1.4\n}"
        },
        "url": {
          "raw": "{{base_url}}/predict",
          "host": ["{{base_url}}"],
          "path": ["predict"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 422', function () {",
              "  pm.response.to.have.status(422);",
              "});",
              "pm.test('Error mentions missing field', function () {",
              "  var body = pm.response.json();",
              "  pm.expect(JSON.stringify(body)).to.include('petal_width');",
              "});"
            ]
          }
        }
      ]
    },
